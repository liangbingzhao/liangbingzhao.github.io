---
import { siGithub, siGooglescholar, siOrcid } from 'simple-icons';
import Icon from './Icon.astro';
import { site } from '../site.config';

const { github, scholar, orcid } = site.socials;
const links = [
  scholar && {
    label: 'Google Scholar',
    href: `https://scholar.google.com/citations?user=${scholar}`,
    path: siGooglescholar.path,
  },
  github && { label: 'GitHub', href: `https://github.com/${github}`, path: siGithub.path },
  orcid && { label: 'ORCID', href: `https://orcid.org/${orcid}`, path: siOrcid.path },
].filter(Boolean) as { label: string; href: string; path: string }[];
---

<div class="socials">
  <a class="social" href={`mailto:${site.email}`} aria-label="Email" title="Email">
    <Icon name="mail" />
  </a>
  {
    links.map((l) => (
      <a class="social" href={l.href} aria-label={l.label} title={l.label} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d={l.path} />
        </svg>
      </a>
    ))
  }
</div>

<style>
  /* The mail icon is stroked; brand icons are filled. */
  .social :global(svg[stroke]) {
    fill: none;
  }
</style>
