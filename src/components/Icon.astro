---
// Small stroke icon set (24×24, currentColor).
interface Props {
  name:
    | 'sun'
    | 'moon'
    | 'arrow-right'
    | 'arrow-up-right'
    | 'mail'
    | 'file'
    | 'download'
    | 'refresh'
    | 'ball'
    | 'building';
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4"/>',
  moon: '<path d="M20.5 13.3A8.5 8.5 0 1 1 10.7 3.5a6.6 6.6 0 0 0 9.8 9.8Z"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m3.5 7 8.5 6 8.5-6"/>',
  file: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z"/><path d="M14 3v5h5M9 13h6M9 17h4"/>',
  download: '<path d="M12 4v11M7 10.5l5 5 5-5M5 20h14"/>',
  refresh:
    '<path d="M19.5 10.5A7.5 7.5 0 0 0 6 6.3L4.5 8"/><path d="M4.5 4v4h4"/><path d="M4.5 13.5A7.5 7.5 0 0 0 18 17.7l1.5-1.7"/><path d="M19.5 20v-4h-4"/>',
  ball: '<circle cx="12" cy="12" r="8.5"/><circle cx="10" cy="8.8" r="1" fill="currentColor" stroke="none"/><circle cx="13.4" cy="8.4" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="11.6" r="1" fill="currentColor" stroke="none"/>',
  building: '<path d="M4 21h16M6 21V8l6-4.5L18 8v13M10 21v-4.5h4V21M9.5 11h.01M14.5 11h.01"/>',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
