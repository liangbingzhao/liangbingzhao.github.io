---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <section class="notfound container">
    <div>
      <span class="eyebrow">404 · t = 1000</span>
      <h1>Pure noise.</h1>
      <p class="page-head__desc" style="margin: 0 auto 28px">Nothing has been sampled at this address yet.</p>
      <a class="btn btn--primary" href="/">Back to the homepage <Icon name="arrow-right" /></a>
    </div>
  </section>
</Base>
